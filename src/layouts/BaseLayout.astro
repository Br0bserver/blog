---
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import BackgroundLayer from '../components/BackgroundLayer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'SWISS BRUTALIST GRID — 瑞士秩序 × 粗野骨架的博客实验',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme =
          saved ??
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
      // 导航转场标记：上一页的点击监听写入（cover-left/cover-right/pager，
      // 管线符后带目的地标签），读出后挂到 html 供 CSS 选择器使用并注入
      // 挡板，读完即清。直接打开/刷新没有标记 → 不播动画
      (function () {
        var nav = sessionStorage.getItem('nav-anim');
        if (!nav) return;
        sessionStorage.removeItem('nav-anim');
        var parts = nav.split('|');
        var mode = parts[0];
        var label = parts[1];
        document.documentElement.dataset.nav = mode;
        if (mode.indexOf('cover') === 0) {
          var slab = document.createElement('div');
          slab.className = 'nav-slab';
          slab.setAttribute('aria-hidden', 'true');
          var word = document.createElement('span');
          word.className = 'slab-word';
          word.textContent = label || '';
          slab.appendChild(word);
          document.documentElement.appendChild(slab);
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700;800;900&family=IBM+Plex+Mono:wght@400;500;700&family=Noto+Sans+SC:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <BackgroundLayer />
    <TopNav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // ---------- 导航转场 ----------
      // 点击监听：只记意图，不拦截导航。站内链接 → 根据目标定方向：
      // 回首页从左揭，其余从右揭；分页条链接 → pager（列表补位）。
      // 携带目的地标签（取路径首段大写）供挡板巨字使用
      document.addEventListener(
        'click',
        (e) => {
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)
            return;
          const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="/"]');
          if (!a || a.target === '_blank' || a.hasAttribute('download')) return;
          const href = a.getAttribute('href') ?? '';
          if (href.startsWith('//')) return;
          if (a.closest('.pager')) {
            sessionStorage.setItem('nav-anim', 'pager');
            return;
          }
          const seg = href.split('/')[1]?.toUpperCase() ?? '';
          const label = seg || 'HOME';
          const mode =
            href === '/' || href.startsWith('/?') ? 'cover-left' : 'cover-right';
          sessionStorage.setItem('nav-anim', mode + '|' + label);
        },
        true,
      );

      // 收尾：入场动画结束后摘除标记与挡板；超时兜底，bfcache 恢复时强制清理
      const finish = () => {
        document.documentElement.removeAttribute('data-nav');
        document.querySelector('.nav-slab')?.remove();
      };
      const slab = document.querySelector<HTMLElement>('.nav-slab');
      const animated = slab ?? document.querySelector('.posts-list');
      if (document.documentElement.dataset.nav && animated) {
        animated.addEventListener('animationend', finish, { once: true });
        setTimeout(finish, 1500);
      }
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) finish();
      });
    </script>
  </body>
</html>
