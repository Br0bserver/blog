---
/**
 * 背景技术层：巨字 / 点阵 / 12列虚线网格 / 边缘标签
 * 全部 pointer-events:none，纯装饰
 */
const edgeText = 'EST. 2026 — SWISS_BRUTAL_DIARY';
---

<div class="bg-layer" aria-hidden="true">
  <div class="bg-words">
    <span class="w1">SWISS</span>
    <span class="w2">BRUTAL</span>
    <span class="w3">2026</span>
  </div>
</div>

<div class="bg-grid-dots" aria-hidden="true">
  <div class="bg-cols">
    {Array.from({ length: 12 }).map(() => <div></div>)}
  </div>
</div>

<div class="edge-label" aria-hidden="true">{edgeText}</div>

<script>
  // 巨字层滚动视差（约 0.78 倍速 = 向下补偿 22% 的滚动量）。
  // 用 rAF 而非 CSS scroll timeline：部分 WebView 的 timeline 实现
  // 会冻结整个页面的滚动。
  const layer = document.querySelector('.bg-words');
  if (layer && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      ticking = false;
      layer.style.transform = `translateY(${window.scrollY * 0.22}px)`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
