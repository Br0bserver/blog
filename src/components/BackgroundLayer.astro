---
/**
 * 背景技术层：巨字 / 点阵 / 12列虚线网格 / 边缘标签
 * 全部 pointer-events:none，纯装饰
 */
const edgeText = 'BR0B — PERSONAL BLOG';
---

<div class="bg-layer" aria-hidden="true">
  <div class="bg-words">
    <span class="w1">BR0B</span>
    <span class="w2">BLOG</span>
    <span class="w3">001</span>
  </div>
</div>

<div class="bg-grid-dots" aria-hidden="true">
  <div class="bg-cols">
    {Array.from({ length: 12 }).map(() => <div />)}
  </div>
</div>

<div class="edge-label" aria-hidden="true">{edgeText}</div>

<script>
  let cleanupBackground = () => {};

  const initBackground = () => {
    cleanupBackground();

    const layer = document.querySelector<HTMLElement>('.bg-words');
    if (!layer) return;

    const controller = new AbortController();
    const { signal } = controller;
    const RATE = 0.35;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;
    let frame = 0;
    let normalizeTimer = 0;

    const update = () => {
      ticking = false;
      layer.style.transform = reduced.matches ? '' : `translateY(${window.scrollY * RATE}px)`;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          frame = requestAnimationFrame(update);
        }
      },
      { passive: true, signal },
    );
    reduced.addEventListener('change', update, { signal });

    // 巨字锚点归一化：短页面也保持与首页接近的词距。
    const normalize = () => {
      const spans = Array.from(layer.querySelectorAll('span'));
      if (spans.length < 2) return;

      const shift = layer.getBoundingClientRect().top + window.scrollY;
      const centers = spans.map((span) => {
        const rect = span.getBoundingClientRect();
        return rect.top + window.scrollY - shift + rect.height / 2;
      });
      const minStep = spans[0].offsetHeight * 1.85;

      for (let index = 1; index < centers.length; index++) {
        centers[index] = Math.max(centers[index], centers[index - 1] + minStep);
      }

      spans.forEach((span, index) => {
        const centered = span.classList.contains('w2');
        const top = centered ? centers[index] : centers[index] - span.offsetHeight / 2;
        span.style.top = `${top}px`;
      });
    };

    window.addEventListener(
      'resize',
      () => {
        clearTimeout(normalizeTimer);
        normalizeTimer = window.setTimeout(normalize, 150);
      },
      { signal },
    );

    update();
    normalize();
    document.fonts?.ready.then(() => {
      if (!signal.aborted) normalize();
    });

    cleanupBackground = () => {
      controller.abort();
      cancelAnimationFrame(frame);
      clearTimeout(normalizeTimer);
    };
  };

  initBackground();
  document.addEventListener('astro:page-load', initBackground);
</script>

<style>
  .bg-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -10;
    user-select: none;
  }

  .bg-words {
    position: absolute;
    inset: 0;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    color: var(--faint);
    opacity: 0.5;
    will-change: transform;
  }

  .bg-words span {
    position: absolute;
    font-size: clamp(300px, 35vw, 450px);
    transform: rotate(-8deg);
  }

  .bg-words .w1 {
    top: 1%;
    left: -5%;
  }
  .bg-words .w2 {
    top: 46%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-8deg);
  }
  .bg-words .w3 {
    top: 90%;
    right: -5%;
  }

  .bg-grid-dots {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    opacity: 0.5;
    pointer-events: none;
  }

  .bg-grid-dots::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--ink) 2px, transparent 0);
    background-size: 24px 24px;
    opacity: 0.1;
  }

  .bg-cols {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    padding-inline: var(--margin);
    opacity: 0.1;
  }

  .bg-cols > div {
    border-right: 1px dashed var(--ink);
    height: 100%;
  }

  .bg-cols > div:last-child {
    border-right: none;
  }

  .edge-label {
    position: fixed;
    right: 1rem;
    top: 50%;
    transform: rotate(-90deg);
    transform-origin: right center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--meta);
    z-index: 0;
    pointer-events: none;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .bg-words span {
      font-size: clamp(220px, 78vw, 300px);
    }

    .edge-label {
      right: 4px;
      font-size: 9px;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }
  }
</style>
