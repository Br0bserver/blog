---
/**
 * 背景技术层：巨字 / 点阵 / 12列虚线网格 / 边缘标签
 * 全部 pointer-events:none，纯装饰
 */
const edgeText = 'EST. 2026 — SWISS_BRUTAL_DIARY';
---

<div class="bg-layer" aria-hidden="true">
  <div class="bg-words">
    <span class="w1">SWISS</span>
    <span class="w2">BRUTAL</span>
    <span class="w3">2026</span>
  </div>
</div>

<div class="bg-grid-dots" aria-hidden="true">
  <div class="bg-cols">
    {Array.from({ length: 12 }).map(() => <div />)}
  </div>
</div>

<div class="edge-label" aria-hidden="true">{edgeText}</div>

<script>
  // 巨字层滚动视差。RATE = 向下补偿比例，1-RATE 即巨字滚动速度
  // （0.35 → 0.65 倍速）。rAF 节流 + 被动监听，只改 transform 走合成器。
  // 用 rAF 而非 CSS scroll timeline：部分 WebView 的 timeline 实现不可靠。
  const layer = document.querySelector<HTMLElement>('.bg-words');
  if (layer) {
    const RATE = 0.35;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;

    const update = () => {
      ticking = false;
      layer.style.transform = reduced.matches ? '' : `translateY(${window.scrollY * RATE}px)`;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    reduced.addEventListener?.('change', update);
    update();
  }

  // 巨字锚点归一化：锚点是文档高度百分比，而字号跟随视口宽度——
  // 短页面（如 /posts）上词距会被压得比字高还小，显得拥挤。
  // 运行时读出各词中心，强制相邻词距 ≥ 1.85 倍字高（首页间距约
  // 1.88 倍，不受影响），再以像素写回。末词若因此被推出文档底部，
  // 会被 overflow:hidden 裁掉，与首页现状一致。
  const wordsLayer = document.querySelector<HTMLElement>('.bg-words');
  const normalize = () => {
    if (!wordsLayer) return;
    const spans = Array.from(wordsLayer.querySelectorAll('span'));
    if (spans.length < 2) return;
    // 视差平移量（reduced-motion 时为 0）：从层自身当前位置反推
    const shift = wordsLayer.getBoundingClientRect().top + window.scrollY;
    const centers = spans.map((s) => {
      const r = s.getBoundingClientRect();
      return r.top + window.scrollY - shift + r.height / 2;
    });
    const minStep = spans[0].offsetHeight * 1.85;
    for (let i = 1; i < centers.length; i++) {
      centers[i] = Math.max(centers[i], centers[i - 1] + minStep);
    }
    spans.forEach((s, i) => {
      // w2 由 translate(-50%,-50%) 中心锚定，top 即中心；其余为顶边锚定
      const centered = s.classList.contains('w2');
      const top = centered ? centers[i] : centers[i] - s.offsetHeight / 2;
      s.style.top = `${top}px`;
    });
  };

  let normalizeTimer = 0;
  window.addEventListener('resize', () => {
    clearTimeout(normalizeTimer);
    normalizeTimer = window.setTimeout(normalize, 150);
  });
  document.fonts?.ready.then(normalize);
  normalize();
</script>

<style>
  .bg-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -10;
    user-select: none;
  }

  .bg-words {
    position: absolute;
    inset: 0;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    color: var(--faint);
    opacity: 0.5;
    will-change: transform;
  }

  .bg-words span {
    position: absolute;
    font-size: clamp(300px, 35vw, 450px);
    transform: rotate(-8deg);
  }

  .w1 {
    top: 1%;
    left: -5%;
  }
  .w2 {
    top: 46%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-8deg);
  }
  .w3 {
    top: 90%;
    right: -5%;
  }

  .bg-grid-dots {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    opacity: 0.5;
    pointer-events: none;
  }

  .bg-grid-dots::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--ink) 2px, transparent 0);
    background-size: 24px 24px;
    opacity: 0.1;
  }

  .bg-cols {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    padding-inline: var(--margin);
    opacity: 0.1;
  }

  .bg-cols > div {
    border-right: 1px dashed var(--ink);
    height: 100%;
  }

  .bg-cols > div:last-child {
    border-right: none;
  }

  .edge-label {
    position: fixed;
    right: 1rem;
    top: 50%;
    transform: rotate(-90deg);
    transform-origin: right center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--meta);
    z-index: 0;
    pointer-events: none;
    white-space: nowrap;
  }
</style>
