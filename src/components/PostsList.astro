---
import PostRow from './PostRow.astro';
import { PAGE_SIZE, wordCount, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  currentPage: number;
}

const { posts, currentPage } = Astro.props;
const totalPosts = posts.length;
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));
const total = String(totalPosts).padStart(3, '0');
const pageNums = Array.from({ length: totalPages }, (_, i) => i + 1);
const pageHref = (n: number) => (n === 1 ? '/posts' : `/posts/page/${n}`);
const prevHref = currentPage > 1 ? pageHref(currentPage - 1) : null;
const nextHref = currentPage < totalPages ? pageHref(currentPage + 1) : null;
---

<div class="page" data-posts-page={currentPage} data-page-size={PAGE_SIZE}>
  <div class="measure-ruler" aria-hidden="true">
    <span>0mm</span>
    <span>1240px</span>
  </div>

  <!-- 页头 -->
  <header class="posts-head">
    <div class="posts-head-main">
      <span class="posts-chip">01 / POSTS</span>
      <h1 class="posts-title">INDEX</h1>
      <p class="posts-desc">
        A complete index of thoughts on design systems, grid discipline, and neo-brutalist raw
        energy.
      </p>
    </div>
    <div class="total-box" aria-label={`共 ${totalPosts} 篇文章`}>
      <span class="total-label">TOTAL ARTICLES</span>
      <span class="total-no">{total}</span>
    </div>
  </header>

  <!-- 排序：日期 / 字数 -->
  <div class="sort-bar" role="group" aria-label="排序方式">
    <span class="sort-label">SORT:</span>
    <button class="sort-btn is-active" data-sort="date" aria-pressed="true"> DATE </button>
    <button class="sort-btn" data-sort="words" aria-pressed="false"> WORD COUNT </button>
  </div>

  <section class="posts-list">
    {
      posts.map((post, i) => (
        <PostRow
          post={post}
          index={(i % PAGE_SIZE) + 1}
          allTags
          words={wordCount(post)}
          hidden={Math.floor(i / PAGE_SIZE) + 1 !== currentPage}
        />
      ))
    }
  </section>

  <!-- 分页 -->
  <nav class="pager" aria-label="分页">
    {
      prevHref ? (
        <a class="pager-btn" href={prevHref}>
          PREV
        </a>
      ) : (
        <span class="pager-btn is-disabled" aria-disabled="true">
          PREV
        </span>
      )
    }
    {
      pageNums.map((n) =>
        n === currentPage ? (
          <span class="pager-btn is-active" aria-current="page">
            {String(n).padStart(2, '0')}
          </span>
        ) : (
          <a class="pager-btn" href={pageHref(n)}>
            {String(n).padStart(2, '0')}
          </a>
        ),
      )
    }
    {
      nextHref ? (
        <a class="pager-btn" href={nextHref}>
          NEXT
        </a>
      ) : (
        <span class="pager-btn is-disabled" aria-disabled="true">
          NEXT
        </span>
      )
    }
  </nav>
</div>

<!-- 单一脚本同时负责首绘恢复和点击交互。放在列表之后同步执行，
     可在首绘前完成 ?sort=words 的全量排序与当前页切片。 -->
<script is:inline>
  (() => {
    const root = document.querySelector('[data-posts-page]');
    const bar = root?.querySelector('.sort-bar');
    const list = root?.querySelector('.posts-list');
    if (!root || !bar || !list) return;

    const page = Number(root.dataset.postsPage);
    const pageSize = Number(root.dataset.pageSize);

    const applySort = (key, updateUrl) => {
      bar.querySelectorAll('.sort-btn').forEach((button) => {
        const active = button.dataset.sort === key;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      const rows = Array.from(list.children).sort(
        (a, b) => Number(b.dataset[key] || 0) - Number(a.dataset[key] || 0),
      );
      const pageStart = (page - 1) * pageSize;
      const pageEnd = pageStart + pageSize;

      rows.forEach((row, index) => {
        list.appendChild(row);
        row.hidden = index < pageStart || index >= pageEnd;
        const number = row.querySelector('.post-row-no');
        if (number) number.textContent = String(index - pageStart + 1).padStart(2, '0');
      });

      const query = key === 'words' ? '?sort=words' : '';
      if (updateUrl) history.replaceState(null, '', location.pathname + query);
      root.querySelectorAll('a.pager-btn').forEach((link) => {
        const path = (link.getAttribute('href') || '').split('?')[0];
        if (path) link.setAttribute('href', path + query);
      });
    };

    const initialSort =
      new URLSearchParams(location.search).get('sort') === 'words' ? 'words' : 'date';
    applySort(initialSort, false);

    bar.addEventListener('click', (event) => {
      const button = event.target.closest('.sort-btn');
      if (button) applySort(button.dataset.sort === 'words' ? 'words' : 'date', true);
    });
  })();
</script>

<style>
  .posts-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    align-items: end;
    margin-bottom: 64px;
  }

  .posts-head-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .posts-chip {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--on-ink);
    background: var(--ink);
    padding: 2px 12px;
    width: max-content;
  }

  .posts-title {
    font-size: clamp(56px, 9vw, 96px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    overflow-wrap: break-words;
  }

  .posts-desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--meta);
    max-width: 560px;
    border-left: 4px solid var(--red);
    padding-left: 16px;
  }

  .total-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 200px;
    padding: 24px 32px;
    color: var(--on-ink);
    background: var(--ink);
    border: var(--border-w) solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--red);
  }

  .total-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--red);
  }

  .total-no {
    font-size: 40px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .sort-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .sort-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--meta);
    margin-right: 8px;
  }

  .sort-btn {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink);
    background: var(--surface);
    border: var(--border-w) solid var(--ink);
    padding: 6px 16px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .sort-btn:hover {
    background: var(--red);
    color: var(--on-red);
  }

  .sort-btn.is-active {
    background: var(--ink);
    color: var(--on-ink);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-bottom: 64px;
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
    margin-bottom: 96px;
  }

  .pager-btn {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink);
    background: var(--surface);
    border: var(--border-w) solid var(--ink);
    padding: 8px 16px;
    min-width: 40px;
    text-align: center;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  a.pager-btn:hover {
    background: var(--red);
    color: var(--on-red);
  }

  .pager-btn.is-active {
    background: var(--ink);
    color: var(--on-ink);
  }

  .pager-btn.is-disabled {
    opacity: 0.3;
  }

  @media (min-width: 768px) {
    .posts-head {
      grid-template-columns: 1fr auto;
    }
  }
</style>
