---
import { formatDate } from '../lib/format';
import { readMinutes, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<aside class="post-side" id="post-side">
  <div class="post-side-inner">
    <div class="meta-card">
      <div class="meta-row">
        <span class="meta-label">PUBLISHED</span>
        <span class="meta-value font-mono">{formatDate(post.data.pubDate)}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">CATEGORY</span>
        <span class="meta-value">{post.data.tags[0]?.toUpperCase() ?? 'POST'}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">READ TIME</span>
        <span class="meta-value font-mono">{readMinutes(post)} MIN</span>
      </div>
      <div class="meta-row meta-row-last meta-row-tags">
        <span class="meta-label">TAGS</span>
        <div class="side-tags-list">
          {
            post.data.tags.map((tag) => (
              <div class="side-tag-row">
                <span class="side-tag-hash font-mono">#</span>
                <span class="side-tag-text font-mono">{tag.toUpperCase()}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</aside>

<style>
  .post-side {
    min-width: 0;
  }

  .meta-card {
    background: var(--surface);
    border: var(--border-w) solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--shadow-c);
    padding: 24px;
  }

  .meta-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 2px solid var(--ink);
  }

  .meta-row-last {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--meta);
  }

  .meta-value {
    font-size: 18px;
    font-weight: 700;
  }

  .side-tags-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;
  }

  .side-tag-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .side-tag-hash {
    color: var(--link);
    font-weight: 800;
    font-size: 13px;
  }

  .side-tag-text {
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .post-side {
      width: 100%;
      overflow: hidden;
      padding-right: 12px;
      padding-bottom: 12px;
      margin-right: -12px;
      margin-bottom: -12px;
      transition:
        opacity 0.28s ease,
        visibility 0.35s;
    }

    .post-side-inner {
      width: 300px;
      transition: transform 0.35s cubic-bezier(0.2, 0, 0, 1);
      transform: translateX(0);
    }

    :global(html[data-post-side='closed']) .post-side {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    :global(html[data-post-side='closed']) .post-side-inner {
      transform: translateX(-40px);
    }
  }

  @media (max-width: 899px) {
    .post-side {
      display: grid;
      grid-template-rows: 1fr;
      opacity: 1;
      overflow: hidden;
      transition:
        grid-template-rows 0.35s cubic-bezier(0.2, 0, 0, 1),
        opacity 0.25s ease,
        margin-bottom 0.35s cubic-bezier(0.2, 0, 0, 1);
      margin-bottom: 24px;
    }

    .post-side-inner {
      min-height: 0;
      padding-right: 8px;
      padding-bottom: 8px;
    }

    :global(html[data-post-side='closed']) .post-side {
      grid-template-rows: 0fr;
      opacity: 0;
      margin-bottom: 0;
      pointer-events: none;
    }

    .meta-card {
      padding: 20px;
      box-shadow: 6px 6px 0 0 var(--shadow-c);
    }

    .meta-value {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-side,
    .post-side-inner {
      transition: none !important;
    }
  }
</style>
