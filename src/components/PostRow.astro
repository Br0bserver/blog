---
import { formatDate } from '../lib/format';
import type { Post } from '../lib/posts';

interface Props {
  post?: Post | null;
  index: number | string;
  words?: number;
  /** 列表页展示全部标签；首页沿用单标签 */
  allTags?: boolean;
  /** 相邻文章等场景可覆盖标签 */
  tags?: string[];
  emptyTitle?: string;
  hidden?: boolean;
  /** 首页首篇等场景展示一至两行摘要 */
  showDescription?: boolean;
}

const {
  post,
  index,
  words,
  allTags = false,
  tags: tagsOverride,
  emptyTitle = 'NO MORE POSTS',
  hidden = false,
  showDescription = false,
} = Astro.props;
const no = typeof index === 'number' ? String(index).padStart(2, '0') : index;
const postTags = post
  ? (allTags ? post.data.tags : post.data.tags.slice(0, 1)).map((tag) => tag.toUpperCase())
  : [];
const tags = tagsOverride ?? (postTags.length ? postTags : ['POST']);
const Element = post ? 'a' : 'div';
---

<Element
  href={post ? `/posts/${post.id}/` : undefined}
  class:list={['post-row', { 'is-empty': !post }]}
  data-date={post?.data.pubDate.valueOf()}
  data-words={words ?? 0}
  hidden={hidden}
>
  <div class="post-row-no">{no}</div>
  <div class="post-row-main">
    <div class="post-row-title">{post?.data.title ?? emptyTitle}</div>
    {
      showDescription && post?.data.description && (
        <p class="post-row-desc">{post.data.description}</p>
      )
    }
    {
      post && (
        <div class="post-row-meta">
          {tags.map((tag) => (
            <span class="post-row-tag">{tag}</span>
          ))}
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {words !== undefined && (
            <span class="post-row-words">{words.toLocaleString('en-US')} 字</span>
          )}
        </div>
      )
    }
  </div>
</Element>

<style>
  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 16px 14px;
    background: var(--surface);
    border: var(--border-w) solid var(--ink);
    box-shadow: 4px 4px 0 0 var(--shadow-c);
    text-decoration: none;
    overflow: hidden;
    transition:
      background 0.16s ease,
      color 0.16s ease,
      transform 0.16s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.16s cubic-bezier(0.2, 0, 0, 1);
  }

  .post-row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 6px;
    background: var(--red);
    transform: translateX(-100%);
    transition: transform 0.16s ease;
  }

  @media (hover: hover) {
    .post-row[href]:hover {
      background: var(--ink);
      color: var(--on-ink);
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0 0 var(--shadow-c);
    }

    .post-row[href]:hover::before {
      transform: translateX(0);
    }

    .post-row[href]:hover .post-row-no {
      color: var(--on-ink);
      border-right-color: var(--on-ink);
    }

    .post-row[href]:hover .post-row-desc {
      color: var(--on-ink);
      opacity: 0.85;
    }

    .post-row[href]:hover .post-row-meta {
      color: var(--on-ink);
    }

    .post-row[href]:hover .post-row-tag {
      background: var(--on-ink);
      color: var(--ink);
      border-color: var(--on-ink);
    }

    .post-row[href]:hover .post-row-words {
      border-color: var(--on-ink);
    }
  }

  .post-row[href]:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 0 var(--shadow-c);
    transition-duration: 0.08s;
  }

  .post-row-no {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 0;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 900;
    color: var(--meta);
    border-right: 2px solid var(--ink);
    transition:
      color 0.16s ease,
      border-color 0.16s ease;
  }

  .post-row-main {
    min-width: 0;
  }

  .post-row-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .post-row-desc {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--meta);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    transition: color 0.16s ease;
  }

  .post-row-meta {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--meta);
    transition: color 0.16s ease;
  }

  .post-row-tag {
    padding: 2px 6px;
    border: 2px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
    transition:
      background 0.16s ease,
      color 0.16s ease,
      border-color 0.16s ease;
  }

  .post-row-words {
    padding: 2px 8px;
    border: 1px solid var(--faint);
    transition: border-color 0.16s ease;
  }

  .is-empty {
    opacity: 0.35;
    box-shadow: none;
  }

  @media (min-width: 768px) {
    .post-row {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: var(--gutter);
      padding: 20px 24px;
      box-shadow: 6px 6px 0 0 var(--shadow-c);
    }

    .post-row::before {
      width: 8px;
    }

    @media (hover: hover) {
      .post-row[href]:hover {
        transform: translate(2px, 2px);
        box-shadow: 4px 4px 0 0 var(--shadow-c);
      }
    }

    .post-row[href]:active {
      transform: translate(6px, 6px);
      box-shadow: 0 0 0 0 var(--shadow-c);
    }

    .post-row-no {
      justify-content: flex-start;
      padding-left: 12px;
      font-size: 20px;
      border-right-width: var(--border-w);
    }

    .post-row-title {
      font-size: 20px;
    }

    .post-row-meta {
      margin-top: 0;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-align: right;
    }

    .post-row-tag {
      padding-inline: 8px;
    }
  }
</style>
