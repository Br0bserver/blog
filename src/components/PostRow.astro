---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
  index: number;
  /** 字数（目前传占位值） */
  words?: number;
  /** 列表页展示全部标签；首页沿用单标签 */
  allTags?: boolean;
}

const { post, index, words, allTags = false } = Astro.props;
const no = String(index).padStart(2, '0');
const tags = (allTags ? post.data.tags : post.data.tags.slice(0, 1)).map((t) =>
  t.toUpperCase(),
);
const fallbackTag = tags.length ? tags : ['POST'];
---

<a
  href={`/posts/${post.id}/`}
  class="post-row"
  data-date={post.data.pubDate.valueOf()}
  data-words={words ?? 0}
>
  <div class="post-row-no">{no}</div>
  <div class="post-row-main">
    <div class="post-row-title">{post.data.title}</div>
    <div class="post-row-meta">
      {fallbackTag.map((t) => (
        <span class="post-row-tag">{t}</span>
      ))}
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      {words !== undefined && (
        <span class="post-row-words">{words.toLocaleString('en-US')} 字</span>
      )}
    </div>
  </div>
</a>

<style>
  .post-row-main {
    min-width: 0;
  }
</style>
