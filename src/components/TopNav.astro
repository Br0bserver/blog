---
const navItems = [
  { href: '/', label: 'HOME' },
  { href: '/posts', label: 'POSTS' },
  { href: '/about', label: 'ABOUT' },
];

const currentPath = Astro.url.pathname;
const normalize = (path: string) => (path.endsWith('/') && path !== '/' ? path.slice(0, -1) : path);
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : normalize(currentPath).startsWith(href);
---

<nav class="topnav">
  <div class="topnav-inner">
    <a class="nav-logo" href="/" aria-label="BRUTALIST_BLOG — 返回首页"> BRUTALIST_BLOG </a>

    <div class="nav-links">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="切换浅色 / 深色模式"
      title="切换浅色 / 深色模式"
    >
      <svg
        class="icon-moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg
        class="icon-sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>
  </div>
</nav>

<script>
  import { initThemeToggle } from '../scripts/themeToggle';
  initThemeToggle();
</script>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
    border-bottom: var(--border-w) solid var(--ink);
  }

  .topnav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    max-width: var(--page-max);
    margin-inline: auto;
    height: 80px;
    padding-inline: var(--margin);
    position: relative;
  }

  .nav-logo {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -0.05em;
    text-decoration: none;
    color: var(--on-ink);
    background: var(--ink);
    padding: 8px 16px;
    border: var(--border-w) solid var(--ink);
  }

  .nav-links {
    display: none;
    gap: var(--gutter);
    align-items: center;
    margin-left: auto;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.12em;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding: 6px 10px;
    border: 2px solid transparent;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    background: var(--ink);
    color: var(--on-ink);
    border-color: var(--ink);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    color: var(--ink);
    background: transparent;
    border: var(--border-w) solid var(--ink);
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: var(--red);
    color: var(--on-red);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 0 var(--shadow-c);
  }

  .theme-toggle:active {
    transform: translate(3px, 3px);
    box-shadow: none;
  }

  @keyframes toggle-pop {
    0%,
    100% {
      transform: scale(1);
    }
    40% {
      transform: scale(0.4);
    }
    70% {
      transform: scale(1.2);
    }
  }

  .theme-toggle.icon-pop svg {
    animation: toggle-pop 0.3s ease;
  }

  .theme-toggle svg {
    width: 24px;
    height: 24px;
  }

  .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .icon-sun {
    display: block;
  }
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }
</style>
