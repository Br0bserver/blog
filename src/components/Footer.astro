---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-logo">BR0B_BLOG</div>

    <div class="footer-links">
      <a class="footer-link" href="/about">ABOUT</a>
      <a class="footer-link" href="/posts">POSTS</a>
      <a class="footer-link" href="/about">CONTACT</a>
    </div>

    <div class="footer-copy">
      ©{year} BR0B PERSONAL BLOG.<br />SOURCE CODE UNDER MIT LICENSE.
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-w) solid var(--ink);
    background: var(--surface);
    margin-top: 72px;
    position: relative;
    z-index: 1;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
    justify-items: center;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--margin);
    min-height: 120px;
  }

  .footer-logo {
    font-size: 20px;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--on-ink);
    background: var(--ink);
    padding: 8px 16px;
    border: var(--border-w) solid var(--ink);
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding: 8px 16px;
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 0 var(--shadow-c);
    transition:
      background 0.15s ease,
      color 0.15s ease,
      transform 0.15s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.15s cubic-bezier(0.2, 0, 0, 1);
  }

  @media (hover: hover) {
    .footer-link:hover {
      background: var(--ink);
      color: var(--on-ink);
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0 0 var(--shadow-c);
    }
  }

  .footer-link:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 0 var(--shadow-c);
    transition-duration: 0.08s;
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--meta);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr 1fr;
      justify-items: stretch;
    }

    .footer-logo {
      justify-self: start;
      align-self: start;
    }
    .footer-links {
      justify-self: center;
    }
    .footer-copy {
      text-align: right;
      align-self: center;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      margin-top: 48px;
    }

    .footer-inner {
      gap: 20px;
      padding-block: 24px;
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    .footer-link {
      min-height: 44px;
      padding: 8px 10px;
    }
  }
</style>
