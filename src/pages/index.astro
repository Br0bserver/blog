---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 3);
---

<BaseLayout title="SWISS BRUTALIST GRID">
  <div class="page">
    <div class="measure-ruler" aria-hidden="true">
      <span>0mm</span>
      <span>1240px</span>
    </div>

    <!-- ISSUE 贴纸 -->
    <div class="issue-sticker" aria-hidden="true">
      <span>ISSUE<br />01</span>
    </div>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-guide" aria-hidden="true">
        <div class="hero-guide-dot"></div>
      </div>
      <div class="hero-main">
        <h1 class="hero-title">
          <span class="text-outline hero-line">THE GRID IS</span>
          <span class="hero-line">
            THE<span class="hero-soul">SOUL</span>
          </span>
        </h1>
        <p class="hero-def">
          <span class="hero-def-tag">DEF.</span>
          A rigorous intersection of
          <span class="chip chip-tilt-neg">Swiss Modernist</span> precision and
          Neo-Brutalist <span class="chip chip-tilt-pos">raw energy</span>.
          Order is the skeleton. Loudness is the personality.
        </p>
      </div>
    </section>

    <!-- SEC_01 -->
    <div class="sec-divider" aria-hidden="true">
      <div class="sec-divider-label tilt-pos">SEC_01</div>
    </div>

    <!-- 01 / INDEX -->
    <section class="section">
      <div class="section-head">
        <h2 class="sec-header">01 / INDEX</h2>
      </div>
      <div class="post-list">
        {latest.map((post, i) => <PostRow post={post} index={i + 1} />)}
      </div>
      <div class="index-more">
        <a class="btn-primary" href="/posts">查看全部</a>
      </div>
    </section>

    <!-- SEC_02 -->
    <div class="sec-divider" aria-hidden="true">
      <div class="sec-divider-label tilt-neg">SEC_02</div>
    </div>

    <!-- 02 / SYSTEM_INFO -->
    <section class="section">
      <div class="section-head section-head-indent">
        <h2 class="sec-header">02 / SYSTEM_INFO</h2>
      </div>

      <div class="sysinfo">
        <!-- 叠纸效果的底层卡 -->
        <div class="sysinfo-backdrop" aria-hidden="true"></div>

        <div class="sysinfo-grid">
          <div class="sysinfo-stats">
            <h3 class="sysinfo-h">SITE_STATS</h3>
            <ul class="stats-list font-mono">
              <li><span>ARTICLES:</span> <span>{String(posts.length).padStart(3, '0')}</span></li>
              <li><span>UPTIME:</span> <span>99.9%</span></li>
              <li><span>SYS.VER:</span> <span>1.0.0</span></li>
              <li>
                <span>RENDER:</span>
                <span class="stats-ok">OK</span>
              </li>
            </ul>
          </div>
          <div class="sysinfo-about">
            <h3 class="sysinfo-h-invert">ABOUT_SYSTEM</h3>
            <p class="sysinfo-text">
              这个日记本存放关于设计系统的想法——那些把功能和原始视觉冲击放在转瞬即逝的潮流之上的想法。它建立在一列不可弯曲的 12
              列网格上，用来证明：约束不是限制，而是创作自由的地基。
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ---------- ISSUE 贴纸 ---------- */
  .issue-sticker {
    position: absolute;
    top: 100px;
    right: 5%;
    width: 128px;
    height: 128px;
    background: var(--red);
    color: var(--on-red);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 900;
    line-height: 1;
    transform: rotate(12deg);
    border: var(--border-w) solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--shadow-c);
    transition: transform 0.5s ease;
    z-index: 20;
  }

  .issue-sticker:hover {
    transform: rotate(45deg);
  }

  /* 新深色方案：贴纸用墨色而非强调色；
     阴影用强调蓝——黑色在深背景上不可见，浅墨色会与贴纸本体糊在一起 */
  :global([data-theme='dark']) .issue-sticker {
    background: var(--ink);
    color: var(--on-ink);
    box-shadow: 8px 8px 0 0 var(--red);
  }

  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    position: relative;
    margin-bottom: 96px;
  }

  .hero-guide {
    display: none;
    position: absolute;
    top: -50px;
    bottom: 0;
    left: -20px;
    width: 4px;
    background: var(--ink);
  }

  .hero-guide-dot {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 24px;
    border: var(--border-w) solid var(--ink);
    background: var(--bg);
  }

  .hero-title {
    font-size: clamp(48px, 10vw, 112px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    overflow-wrap: break-words;
  }

  .hero-line {
    display: block;
  }

  .hero-soul {
    display: inline-block;
    margin-left: 0.15em;
    padding: 0 8px;
    background: var(--red);
    color: var(--on-red);
    box-shadow: inset 0 -16px 0 0 var(--red);
  }

  .hero-def {
    position: relative;
    max-width: 672px;
    margin-top: 32px;
    margin-left: 24px;
    padding: 24px;
    font-size: 18px;
    background: var(--surface);
    border: var(--border-w) solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--shadow-c);
  }

  .hero-def-tag {
    position: absolute;
    top: -16px;
    left: -16px;
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--on-ink);
    background: var(--ink);
    border: 2px solid var(--surface);
  }

  .chip {
    display: inline-block;
    padding: 0 4px;
    font-weight: 700;
    background: var(--ink);
    color: var(--on-ink);
    border: var(--border-w) solid var(--ink);
  }

  .chip-tilt-neg { transform: rotate(-2deg); }
  .chip-tilt-pos { transform: rotate(2deg); background: var(--surface); color: var(--ink); }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: repeat(12, 1fr);
    }

    .hero-main {
      grid-column: 1 / 11;
    }

    .hero-guide {
      display: block;
    }
  }

  /* ---------- 区块通用 ---------- */
  .section {
    position: relative;
    margin-bottom: 96px;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
  }

  .section-head-indent {
    padding-left: 32px;
  }

  @media (min-width: 768px) {
    .section-head-indent {
      padding-left: 0;
    }
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 32px;
  }

  .index-more {
    margin-top: 48px;
    display: flex;
    justify-content: flex-end;
  }

  /* ---------- SYSTEM_INFO ---------- */
  .sysinfo {
    position: relative;
    z-index: 1;
    margin-top: 32px;
  }

  .sysinfo-backdrop {
    position: absolute;
    inset: 0;
    background: var(--ink);
    border: var(--border-w) solid var(--ink);
    transform: translate(16px, 16px);
    z-index: 0;
    display: none;
  }

  /* 暗色下墨色即浅灰，纯墨衬底会变成亮板（夹心饼干）：
     衬底归入阴影家族，随 --shadow-c 一起走 */
  :global([data-theme='dark']) .sysinfo-backdrop {
    background: var(--shadow-c);
    border-color: var(--shadow-c);
  }

  .sysinfo-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    background: var(--surface);
    border: var(--border-w) solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--shadow-c);
  }

  .sysinfo-stats {
    padding: 32px;
    border-bottom: var(--border-w) solid var(--ink);
  }

  .sysinfo-h {
    font-size: 20px;
    font-weight: 900;
    text-transform: uppercase;
    border-bottom: var(--border-w) solid var(--ink);
    padding-bottom: 8px;
    margin-bottom: 24px;
  }

  .stats-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 16px;
    font-weight: 700;
  }

  .stats-list li {
    display: flex;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--hairline);
  }

  .stats-list li + li {
    margin-top: 16px;
  }

  .stats-ok {
    padding: 0 8px;
    color: var(--on-ink);
    background: var(--ink);
    border: 2px solid var(--ink);
  }

  .sysinfo-about {
    padding: 48px 32px;
    background: var(--ink);
    color: var(--on-ink);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* 暗色下面板不做 token 级反白（会变成大亮板/灰板）：
     深底 + 浅字 + 浅色标签块，与浅色版"黑面板白chip"同一视觉结构 */
  :global([data-theme='dark']) .sysinfo-about {
    background: var(--surface);
    color: var(--ink);
  }

  :global([data-theme='dark']) .sysinfo-h-invert {
    color: var(--on-ink);
    background: var(--ink);
    border-color: var(--ink);
  }

  .sysinfo-h-invert {
    align-self: flex-start;
    font-size: 20px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--on-ink);
    padding: 4px 8px;
    border: var(--border-w) solid var(--on-ink);
    margin-bottom: 24px;
  }

  .sysinfo-text {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.7;
    border-left: 8px solid var(--red);
    padding-left: 24px;
  }

  @media (min-width: 768px) {
    .sysinfo-backdrop {
      display: block;
    }

    .sysinfo-grid {
      grid-template-columns: 4fr 8fr;
    }

    .sysinfo-stats {
      border-bottom: none;
      border-right: var(--border-w) solid var(--ink);
    }

    .sysinfo-about {
      padding: 48px;
    }
  }
</style>
