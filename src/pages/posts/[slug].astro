---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import AdjacentPosts from '../../components/AdjacentPosts.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import PostMeta from '../../components/PostMeta.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortedPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index - 1] ?? null,
      next: posts[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: Post;
  prev: Post | null;
  next: Post | null;
}

const { post, prev, next } = Astro.props as Props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="page">
    <div class="measure-ruler" aria-hidden="true">
      <span></span>
      <span></span>
    </div>

    <script is:inline>
      (() => {
        const savedPostSide = localStorage.getItem('post-sidebar');
        const narrowPostViewport = window.matchMedia('(max-width: 899px)').matches;
        document.documentElement.dataset.postSide =
          savedPostSide === 'closed' || (savedPostSide === null && narrowPostViewport)
            ? 'closed'
            : 'open';
      })();
    </script>

    <div class="post-layout">
      <div class="post-top">
        <a class="back-link" href="/posts">
          <span class="back-arrow" aria-hidden="true">‹</span>
          BACK TO POSTS
        </a>
        <button class="side-toggle" type="button" aria-expanded="true" aria-controls="post-side">
          <span class="side-arrow" aria-hidden="true"></span>
          META
        </button>
      </div>

      <PostMeta post={post} />
      <ArticleContent title={post.data.title}>
        <Content />
      </ArticleContent>
    </div>

    <AdjacentPosts prev={prev} next={next} />
  </div>
</BaseLayout>

<script>
  const initPostSidebar = () => {
    const toggle = document.querySelector<HTMLButtonElement>('.side-toggle');
    if (!toggle || toggle.dataset.sidebarBound === 'true') return;
    toggle.dataset.sidebarBound = 'true';

    const syncSidebar = (closed: boolean) => toggle.setAttribute('aria-expanded', String(!closed));

    const storedPostSide = localStorage.getItem('post-sidebar');
    const storedClosed =
      storedPostSide === 'closed' ||
      (storedPostSide === null && window.matchMedia('(max-width: 899px)').matches);
    document.documentElement.dataset.postSide = storedClosed ? 'closed' : 'open';
    syncSidebar(storedClosed);

    toggle.addEventListener('click', () => {
      const closed = document.documentElement.dataset.postSide !== 'closed';
      document.documentElement.dataset.postSide = closed ? 'closed' : 'open';
      localStorage.setItem('post-sidebar', closed ? 'closed' : 'open');
      syncSidebar(closed);
    });
  };

  initPostSidebar();
  document.addEventListener('astro:page-load', initPostSidebar);
</script>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gutter);
    align-items: start;
    margin-bottom: 96px;
  }

  .post-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 32px;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--red);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }

  .back-link:hover {
    border-bottom-color: var(--red);
  }

  .back-arrow {
    display: inline-block;
    margin-right: 8px;
    transition: transform 0.15s ease;
  }

  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }

  .side-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink);
    background: var(--surface);
    border: var(--border-w) solid var(--ink);
    padding: 6px 16px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .side-toggle:hover {
    background: var(--ink);
    color: var(--on-ink);
  }

  .side-arrow::after {
    content: '‹';
  }

  :global(html[data-post-side='closed']) .side-arrow::after {
    content: '›';
  }

  @media (min-width: 900px) {
    .post-layout {
      grid-template-columns: 300px minmax(0, 1fr);
      transition:
        grid-template-columns 0.3s cubic-bezier(0.2, 0, 0, 1),
        gap 0.3s cubic-bezier(0.2, 0, 0, 1);
    }

    .post-top {
      grid-column: 1 / -1;
    }

    :global(html[data-post-side='closed']) .post-layout {
      grid-template-columns: 0 minmax(0, 1fr);
      gap: 0;
    }
  }

  @media (max-width: 899px) {
    .post-layout {
      margin-bottom: 64px;
    }

    .post-top {
      gap: 12px;
      margin-bottom: 8px;
    }

    .side-toggle {
      min-height: 44px;
    }
  }
</style>
